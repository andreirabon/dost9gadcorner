# Laravel Development Patterns

Comprehensive patterns for Laravel 12 application development with PHP 8.2+.

## Controller Patterns

### Resource Controllers

```php
<?php

namespace App\Http\Controllers;

use App\Models\Market;
use App\Http\Requests\StoreMarketRequest;
use App\Http\Requests\UpdateMarketRequest;
use Illuminate\Http\RedirectResponse;
use Inertia\Inertia;
use Inertia\Response;

class MarketController extends Controller
{
    /**
     * Display a listing of the resource.
     */
    public function index(): Response
    {
        return Inertia::render('Markets/Index', [
            'markets' => Market::query()
                ->select('id', 'name', 'status', 'created_at')
                ->latest()
                ->paginate(20),
            'filters' => request()->only('search', 'status'),
        ]);
    }

    /**
     * Show the form for creating a new resource.
     */
    public function create(): Response
    {
        return Inertia::render('Markets/Create');
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store(StoreMarketRequest $request): RedirectResponse
    {
        $market = Market::create($request->validated());

        return redirect()
            ->route('markets.show', $market)
            ->with('message', 'Market created successfully.');
    }

    /**
     * Display the specified resource.
     */
    public function show(Market $market): Response
    {
        return Inertia::render('Markets/Show', [
            'market' => $market->load('creator', 'positions'),
        ]);
    }

    /**
     * Update the specified resource in storage.
     */
    public function update(UpdateMarketRequest $request, Market $market): RedirectResponse
    {
        $market->update($request->validated());

        return back()->with('message', 'Market updated successfully.');
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy(Market $market): RedirectResponse
    {
        $market->delete();

        return redirect()
            ->route('markets.index')
            ->with('message', 'Market deleted successfully.');
    }
}
```

### Dependency Injection in Controllers

```php
<?php

namespace App\Http\Controllers;

use App\Repositories\MarketRepository;
use App\Services\MarketService;
use Illuminate\Container\Attributes\Cache;
use Illuminate\Container\Attributes\Config;
use Illuminate\Container\Attributes\Log;
use Illuminate\Contracts\Cache\Repository;
use Psr\Log\LoggerInterface;

class MarketController extends Controller
{
    /**
     * Create a new controller instance.
     *
     * Dependencies are automatically injected by Laravel's service container.
     */
    public function __construct(
        protected MarketService $marketService,
        protected MarketRepository $marketRepository,
        #[Cache('redis')] protected Repository $cache,
        #[Log('daily')] protected LoggerInterface $log,
        #[Config('app.markets.default_limit')] protected int $defaultLimit,
    ) {}

    /**
     * Search markets using the injected service.
     */
    public function search(Request $request): Response
    {
        $this->log->info('Market search initiated', [
            'query' => $request->input('q'),
        ]);

        $results = $this->marketService->search(
            query: $request->input('q'),
            limit: $request->input('limit', $this->defaultLimit)
        );

        return Inertia::render('Markets/Search', [
            'results' => $results,
        ]);
    }
}
```

## Form Request Validation

### Creating Form Requests

```php
<?php

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

class StoreMarketRequest extends FormRequest
{
    /**
     * Determine if the user is authorized to make this request.
     */
    public function authorize(): bool
    {
        return $this->user()->can('create', Market::class);
    }

    /**
     * Get the validation rules that apply to the request.
     *
     * @return array<string, \Illuminate\Contracts\Validation\ValidationRule|array<mixed>|string>
     */
    public function rules(): array
    {
        return [
            'name' => ['required', 'string', 'max:200'],
            'description' => ['required', 'string', 'max:2000'],
            'category' => ['required', Rule::in(['politics', 'sports', 'finance'])],
            'end_date' => ['required', 'date', 'after:now'],
            'options' => ['required', 'array', 'min:2'],
            'options.*.name' => ['required', 'string', 'max:100'],
            'options.*.initial_probability' => ['required', 'numeric', 'between:0,100'],
        ];
    }

    /**
     * Get custom attributes for validator errors.
     */
    public function attributes(): array
    {
        return [
            'options.*.name' => 'option name',
            'options.*.initial_probability' => 'initial probability',
        ];
    }

    /**
     * Get the error messages for the defined validation rules.
     */
    public function messages(): array
    {
        return [
            'end_date.after' => 'The market must end in the future.',
            'options.min' => 'A market must have at least 2 options.',
        ];
    }

    /**
     * Prepare the data for validation.
     */
    protected function prepareForValidation(): void
    {
        $this->merge([
            'slug' => str($this->name)->slug(),
        ]);
    }
}
```

### Using Form Requests in Controllers

```php
public function store(StoreMarketRequest $request): RedirectResponse
{
    // Validation happens automatically before this method is called

    // Retrieve all validated input
    $validated = $request->validated();

    // Retrieve specific validated fields
    $safe = $request->safe()->only(['name', 'description']);

    // Retrieve all except specific fields
    $withoutOptions = $request->safe()->except(['options']);

    $market = Market::create($validated);

    return redirect()->route('markets.show', $market);
}
```

## Service Layer Pattern

### Service Class

```php
<?php

namespace App\Services;

use App\Models\Market;
use App\Repositories\MarketRepository;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\DB;

class MarketService
{
    public function __construct(
        protected MarketRepository $repository,
    ) {}

    /**
     * Create a new market with options.
     */
    public function createMarketWithOptions(array $data): Market
    {
        return DB::transaction(function () use ($data) {
            $market = $this->repository->create([
                'name' => $data['name'],
                'description' => $data['description'],
                'category' => $data['category'],
                'end_date' => $data['end_date'],
                'creator_id' => auth()->id(),
            ]);

            foreach ($data['options'] as $option) {
                $market->options()->create($option);
            }

            // Clear cache
            Cache::tags(['markets'])->flush();

            // Dispatch events
            event(new MarketCreated($market));

            return $market->load('options');
        });
    }

    /**
     * Search markets with caching.
     */
    public function search(string $query, int $limit = 10): array
    {
        $cacheKey = "market_search:{$query}:{$limit}";

        return Cache::remember($cacheKey, now()->addMinutes(5), function () use ($query, $limit) {
            return $this->repository->search($query, $limit);
        });
    }

    /**
     * Calculate market statistics.
     */
    public function calculateStats(Market $market): array
    {
        return [
            'total_volume' => $market->positions()->sum('amount'),
            'unique_traders' => $market->positions()->distinct('user_id')->count(),
            'current_probabilities' => $this->calculateProbabilities($market),
            'recent_trades' => $market->positions()
                ->latest()
                ->take(10)
                ->get(),
        ];
    }

    /**
     * Calculate current probabilities for market options.
     */
    protected function calculateProbabilities(Market $market): array
    {
        $positions = $market->positions()
            ->select('option_id', DB::raw('SUM(amount) as total_volume'))
            ->groupBy('option_id')
            ->get();

        $totalVolume = $positions->sum('total_volume');

        return $positions->mapWithKeys(function ($position) use ($totalVolume) {
            return [
                $position->option_id => [
                    'probability' => $totalVolume > 0
                        ? ($position->total_volume / $totalVolume) * 100
                        : 0,
                    'volume' => $position->total_volume,
                ],
            ];
        })->toArray();
    }
}
```

## Repository Pattern

### Repository Interface

```php
<?php

namespace App\Repositories;

use App\Models\Market;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Support\Collection;

interface MarketRepositoryInterface
{
    public function findAll(): Collection;

    public function findById(int $id): ?Market;

    public function findBySlug(string $slug): ?Market;

    public function paginate(int $perPage = 15): LengthAwarePaginator;

    public function create(array $data): Market;

    public function update(Market $market, array $data): Market;

    public function delete(Market $market): bool;

    public function search(string $query, int $limit = 10): array;
}
```

### Repository Implementation

```php
<?php

namespace App\Repositories;

use App\Models\Market;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Support\Collection;

class MarketRepository implements MarketRepositoryInterface
{
    public function __construct(
        protected Market $model,
    ) {}

    public function findAll(): Collection
    {
        return $this->model
            ->select('id', 'name', 'status', 'created_at')
            ->get();
    }

    public function findById(int $id): ?Market
    {
        return $this->model->find($id);
    }

    public function findBySlug(string $slug): ?Market
    {
        return $this->model
            ->where('slug', $slug)
            ->firstOrFail();
    }

    public function paginate(int $perPage = 15): LengthAwarePaginator
    {
        return $this->model
            ->latest()
            ->paginate($perPage);
    }

    public function create(array $data): Market
    {
        return $this->model->create($data);
    }

    public function update(Market $market, array $data): Market
    {
        $market->update($data);
        return $market->fresh();
    }

    public function delete(Market $market): bool
    {
        return $market->delete();
    }

    public function search(string $query, int $limit = 10): array
    {
        return $this->model
            ->where('name', 'like', "%{$query}%")
            ->orWhere('description', 'like', "%{$query}%")
            ->limit($limit)
            ->get()
            ->toArray();
    }
}
```

### Binding Repository in Service Provider

```php
<?php

namespace App\Providers;

use App\Repositories\MarketRepository;
use App\Repositories\MarketRepositoryInterface;
use Illuminate\Support\ServiceProvider;

class RepositoryServiceProvider extends ServiceProvider
{
    public function register(): void
    {
        $this->app->bind(
            MarketRepositoryInterface::class,
            MarketRepository::class
        );
    }
}
```

## Eloquent Model Patterns

### Model with Relationships and Scopes

```php
<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\SoftDeletes;
use Illuminate\Database\Eloquent\Builder;

class Market extends Model
{
    use HasFactory, SoftDeletes;

    /**
     * The attributes that are mass assignable.
     */
    protected $fillable = [
        'name',
        'slug',
        'description',
        'category',
        'status',
        'end_date',
        'creator_id',
    ];

    /**
     * The attributes that should be cast.
     */
    protected function casts(): array
    {
        return [
            'end_date' => 'datetime',
            'created_at' => 'datetime',
            'updated_at' => 'datetime',
        ];
    }

    /**
     * Get the creator of the market.
     */
    public function creator(): BelongsTo
    {
        return $this->belongsTo(User::class, 'creator_id');
    }

    /**
     * Get the options for the market.
     */
    public function options(): HasMany
    {
        return $this->hasMany(MarketOption::class);
    }

    /**
     * Get all positions in this market.
     */
    public function positions(): HasMany
    {
        return $this->hasMany(Position::class);
    }

    /**
     * Scope a query to only include active markets.
     */
    public function scopeActive(Builder $query): void
    {
        $query->where('status', 'active')
              ->where('end_date', '>', now());
    }

    /**
     * Scope a query to filter by category.
     */
    public function scopeCategory(Builder $query, string $category): void
    {
        $query->where('category', $category);
    }

    /**
     * Scope a query to search by name or description.
     */
    public function scopeSearch(Builder $query, string $search): void
    {
        $query->where(function ($q) use ($search) {
            $q->where('name', 'like', "%{$search}%")
              ->orWhere('description', 'like', "%{$search}%");
        });
    }

    /**
     * Check if the market is currently active.
     */
    public function isActive(): bool
    {
        return $this->status === 'active'
            && $this->end_date > now();
    }

    /**
     * Get the route key for the model.
     */
    public function getRouteKeyName(): string
    {
        return 'slug';
    }
}
```

