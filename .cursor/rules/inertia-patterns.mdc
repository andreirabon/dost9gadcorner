## Shared Data Patterns

### Sharing Data from Laravel Middleware

```php
<?php

// app/Http/Middleware/HandleInertiaRequests.php

namespace App\Http\Middleware;

use Illuminate\Http\Request;
use Inertia\Middleware;

class HandleInertiaRequests extends Middleware
{
    /**
     * Define the props that are shared by default.
     */
    public function share(Request $request): array
    {
        return array_merge(parent::share($request), [
            // Always included on every request
            'appName' => config('app.name'),

            // Lazy evaluation - only computed when accessed
            'auth' => [
                'user' => fn() => $request->user()
                    ? $request->user()->only('id', 'name', 'email', 'avatar')
                    : null,
            ],

            // Flash messages from session
            'flash' => [
                'message' => fn() => $request->session()->get('message'),
                'error' => fn() => $request->session()->get('error'),
                'success' => fn() => $request->session()->get('success'),
            ],

            // Permissions
            'permissions' => fn() => [
                'canCreateMarkets' => $request->user()?->can('create', \App\Models\Market::class),
                'canManageUsers' => $request->user()?->hasRole('admin'),
            ],

            // Ziggy routes (for route() helper in Vue)
            'ziggy' => fn() => [
                ...\Tightenco\Ziggy\Ziggy::generate()->toArray(),
                'location' => $request->url(),
            ],
        ]);
    }
}
```

### Accessing Shared Data in Vue (Options API)

```vue
<script>
import { defineComponent } from 'vue';
import { usePage } from '@inertiajs/vue3';
import { Link } from '@inertiajs/vue3';

export default defineComponent({
    components: {
        Link,
    },

    setup() {
        const page = usePage();
        return { page };
    },

    computed: {
        user() {
            return this.page.props.auth.user;
        },

        flash() {
            return this.page.props.flash;
        },

        canCreateMarkets() {
            return this.page.props.permissions?.canCreateMarkets;
        },
    },
});
</script>

<template>
    <div>
        <!-- Flash messages -->
        <div v-if="flash.success" class="alert alert-success">
            {{ flash.success }}
        </div>

        <div v-if="flash.error" class="alert alert-error">
            {{ flash.error }}
        </div>

        <!-- User info -->
        <header v-if="user">
            <img :src="user.avatar" :alt="user.name" />
            <span>{{ user.name }}</span>
        </header>

        <!-- Conditional rendering based on permissions -->
        <Link v-if="canCreateMarkets" href="/markets/create">
            Create Market
        </Link>
    </div>
</template>
```

## Navigation Patterns

### Link Component

```vue
<template>
    <!-- ✅ Basic link -->
    <Link href="/markets">Markets</Link>

    <!-- ✅ Link with method -->
    <Link href="/logout" method="post" as="button"> Logout </Link>

    <!-- ✅ Link with confirmation -->
    <Link
        href="/markets/1"
        method="delete"
        as="button"
        @before="() => confirm('Are you sure?')"
    >
        Delete
    </Link>

    <!-- ✅ Link with custom data -->
    <Link href="/markets" :data="{ search: 'election', status: 'active' }">
        Search
    </Link>

    <!-- ✅ Preserve scroll position -->
    <Link href="/markets?page=2" preserve-scroll> Next Page </Link>

    <!-- ✅ Replace history state -->
    <Link href="/markets" replace> Markets </Link>

    <!-- ✅ Active link styling -->
    <Link href="/markets" :class="{ active: $page.url === '/markets' }">
        Markets
    </Link>
</template>
```

### Programmatic Navigation (Options API)

```vue
<script>
import { defineComponent } from 'vue';

export default defineComponent({
    methods: {
        navigateToMarkets() {
            this.$inertia.get('/markets');
        },

        searchMarkets(query) {
            this.$inertia.get(
                '/markets',
                { search: query },
                {
                    preserveState: true,
                    preserveScroll: true,
                    only: ['markets'], // Only reload 'markets' prop
                },
            );
        },

        createMarket(data) {
            this.$inertia.post('/markets', data, {
                onSuccess: () => {
                    console.log('Market created!');
                },
                onError: (errors) => {
                    console.error('Validation failed:', errors);
                },
            });
        },

        deleteMarket(id) {
            if (confirm('Are you sure?')) {
                this.$inertia.delete(`/markets/${id}`);
            }
        },
    },
});
</script>
```

