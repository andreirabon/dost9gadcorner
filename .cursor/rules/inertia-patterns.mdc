## Advanced Patterns

### Partial Reloads (Options API)

```vue
<script>
import { defineComponent } from 'vue';

export default defineComponent({
    methods: {
        updateMarketStatus(marketId, status) {
            this.$inertia.patch(
                `/markets/${marketId}`,
                { status },
                {
                    // Only reload specific props
                    only: ['market', 'flash'],
                    preserveScroll: true,
                },
            );
        },

        filterMarkets(filters) {
            this.$inertia.get('/markets', filters, {
                // Only reload markets list, keep other data
                only: ['markets'],
                preserveState: true,
                preserveScroll: true,
            });
        },
    },
});
</script>
```

### Manual Form Submissions (Options API)

```vue
<script>
import { defineComponent } from 'vue';

export default defineComponent({
    data() {
        return {
            form: {
                name: '',
                description: '',
            },
            errors: {},
            processing: false,
        };
    },

    methods: {
        submit() {
            this.processing = true;

            this.$inertia.post('/markets', this.form, {
                onSuccess: () => {
                    this.form = { name: '', description: '' };
                    this.errors = {};
                },
                onError: (serverErrors) => {
                    this.errors = serverErrors;
                },
                onFinish: () => {
                    this.processing = false;
                },
            });
        },
    },
});
</script>
```

### Remember Scroll Position (Options API)

```vue
<script>
import { defineComponent } from 'vue';

export default defineComponent({
    methods: {
        searchMarkets(query) {
            this.$inertia.get(
                '/markets',
                { search: query },
                {
                    preserveScroll: true,
                    // or
                    preserveScroll: (page) => {
                        // Custom logic to determine if scroll should be preserved
                        return page.props.markets.current_page > 1;
                    },
                },
            );
        },
    },
});
</script>
```

### Global Event Listeners (Options API)

```vue
<script>
import { defineComponent } from 'vue';
import { router } from '@inertiajs/vue3';

export default defineComponent({
    data() {
        return {
            listeners: [],
        };
    },

    mounted() {
        this.listeners.push(
            router.on('start', (event) => {
                console.log('Navigation started to:', event.detail.visit.url);
            }),
        );

        this.listeners.push(
            router.on('progress', (event) => {
                console.log(
                    'Upload progress:',
                    event.detail.progress.percentage,
                );
            }),
        );

        this.listeners.push(
            router.on('success', (event) => {
                console.log('Navigation completed successfully');
            }),
        );

        this.listeners.push(
            router.on('error', (errors) => {
                console.error('Validation errors:', errors);
            }),
        );
    },

    beforeUnmount() {
        // Clean up all listeners
        this.listeners.forEach((removeListener) => removeListener());
    },
});
</script>
```

## Testing Patterns

### Testing Inertia Responses (Laravel)

```php
<?php

use function Pest\Laravel\{get, post};

test('markets index returns inertia response', function () {
    get('/markets')
        ->assertOk()
        ->assertInertia(fn($page) =>
            $page->component('Markets/Index')
                ->has('markets')
        );
});

test('markets index passes correct data', function () {
    Market::factory()->count(3)->create();

    get('/markets')
        ->assertInertia(fn($page) =>
            $page->component('Markets/Index')
                ->has('markets.data', 3)
                ->has('markets.data.0', fn($market) =>
                    $market->has('id')
                        ->has('name')
                        ->has('status')
                )
        );
});
```

## Performance Optimization

### Limiting Data Sent to Frontend

```php
<?php

// ❌ BAD: Sending all data
public function index()
{
    return Inertia::render('Markets/Index', [
        'markets' => Market::with('creator', 'options', 'positions')->get(),
    ]);
}

// ✅ GOOD: Select only needed fields
public function index()
{
    return Inertia::render('Markets/Index', [
        'markets' => Market::query()
            ->select('id', 'name', 'status', 'created_at')
            ->with('creator:id,name')
            ->paginate(20),
    ]);
}
```

### Using Lazy Props

```php
<?php

public function show(Market $market)
{
    return Inertia::render('Markets/Show', [
        'market' => $market,

        // Expensive data loaded only when accessed
        'analytics' => Inertia::lazy(fn() => $this->getAnalytics($market)),
        'relatedMarkets' => Inertia::lazy(fn() => $this->getRelatedMarkets($market)),
    ]);
}
```

**Remember**: Inertia.js bridges Laravel and Vue seamlessly. Use server-side routing with Vue 3 Options API, leverage Laravel's features, and build reactive UIs without building a separate API. Follow these patterns for maintainable, performant SPAs.
