# Inertia.js Development Patterns

Comprehensive patterns for building SPAs with Laravel and Vue 3 Options API using Inertia.js.

## Page Component Patterns

### Basic Page Component (Options API)

```vue
<script>
import { defineComponent } from 'vue';
import { Head, Link } from '@inertiajs/vue3';
import AppLayout from '@/layouts/AppLayout.vue';

export default defineComponent({
    components: {
        Head,
        Link,
        AppLayout,
    },

    // Props passed from Laravel controller
    props: {
        markets: {
            type: Object,
            required: true,
        },
        filters: {
            type: Object,
            default: () => ({}),
        },
    },

    data() {
        return {
            localFilters: { ...this.filters },
        };
    },

    methods: {
        search() {
            this.$inertia.get('/markets', this.localFilters, {
                preserveState: true,
                preserveScroll: true,
            });
        },
    },
});
</script>

<template>
    <AppLayout>
        <Head title="Markets" />

        <div class="markets">
            <h1>Markets</h1>

            <!-- Search functionality -->
            <input
                v-model="localFilters.search"
                @input="search"
                placeholder="Search markets..."
            />

            <!-- Market list -->
            <div v-for="market in markets.data" :key="market.id">
                <Link :href="`/markets/${market.id}`">
                    {{ market.name }}
                </Link>
            </div>
        </div>
    </AppLayout>
</template>
```

## Laravel Controller Patterns

### Rendering Inertia Pages

```php
<?php

namespace App\Http\Controllers;

use App\Models\Market;
use Inertia\Inertia;
use Inertia\Response;

class MarketController extends Controller
{
    /**
     * Display a listing of markets.
     */
    public function index(): Response
    {
        return Inertia::render('Markets/Index', [
            // Only pass needed data
            'markets' => Market::query()
                ->select('id', 'name', 'status', 'created_at')
                ->with('creator:id,name')
                ->latest()
                ->paginate(20),

            // Preserve filters
            'filters' => request()->only('search', 'status'),
        ]);
    }

    /**
     * Display a specific market.
     */
    public function show(Market $market): Response
    {
        return Inertia::render('Markets/Show', [
            'market' => $market->load([
                'creator:id,name,email',
                'options:id,market_id,name',
                'positions' => fn($query) => $query->latest()->take(10)
            ]),
        ]);
    }

    /**
     * Using the inertia() helper (shorthand).
     */
    public function create(): Response
    {
        return inertia('Markets/Create');
    }
}
```

### Lazy Loading Data

```php
<?php

use Inertia\Inertia;

public function show(Market $market): Response
{
    return Inertia::render('Markets/Show', [
        'market' => $market,

        // ✅ Lazy load expensive data - only loaded when accessed
        'analytics' => Inertia::lazy(fn() => [
            'totalVolume' => $market->positions()->sum('amount'),
            'uniqueTraders' => $market->positions()->distinct('user_id')->count(),
            'recentTrades' => $market->positions()->latest()->take(10)->get(),
        ]),

        // ✅ Optional data - included in initial page load but can be made lazy
        'relatedMarkets' => Inertia::optional(
            fn() => Market::where('category', $market->category)
                ->where('id', '!=', $market->id)
                ->take(5)
                ->get()
        ),
    ]);
}
```

