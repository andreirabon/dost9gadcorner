    <TransitionGroup name="list" tag="div" class="market-list">
        <MarketCard
            v-for="market in markets"
            :key="market.id"
            :market="market"
        />
    </TransitionGroup>
</template>

<style scoped>
.list-enter-active,
.list-leave-active {
    transition: all 0.3s ease;
}

.list-enter-from {
    opacity: 0;
    transform: translateY(20px);
}

.list-leave-to {
    opacity: 0;
    transform: translateY(-20px);
}
</style>

<!-- Modal Animations -->
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    props: {
        isOpen: {
            type: Boolean,
            required: true,
        },
    },

    emits: ['close'],
});
</script>

<template>
    <Teleport to="body">
        <Transition name="modal">
            <div v-if="isOpen" class="modal-wrapper">
                <div class="modal-overlay" @click="$emit('close')" />
                <div class="modal-content">
                    <slot />
                </div>
            </div>
        </Transition>
    </Teleport>
</template>

<style scoped>
.modal-enter-active,
.modal-leave-active {
    transition: opacity 0.3s ease;
}

.modal-enter-from,
.modal-leave-to {
    opacity: 0;
}

.modal-content {
    transition: all 0.3s ease;
}

.modal-enter-from .modal-content,
.modal-leave-to .modal-content {
    opacity: 0;
    transform: scale(0.9) translateY(20px);
}

.modal-enter-to .modal-content {
    opacity: 1;
    transform: scale(1) translateY(0);
}
</style>
```

## Accessibility Patterns (Vue 3)

### Keyboard Navigation

```vue
<script lang="ts">
import { defineComponent, PropType } from 'vue';

interface Option {
    value: string;
    label: string;
}

export default defineComponent({
    props: {
        options: {
            type: Array as PropType<Option[]>,
            required: true,
        },
    },

    emits: ['select'],

    data() {
        return {
            isOpen: false,
            activeIndex: 0,
        };
    },

    methods: {
        handleKeyDown(e: KeyboardEvent) {
            switch (e.key) {
                case 'ArrowDown':
                    e.preventDefault();
                    this.activeIndex = Math.min(
                        this.activeIndex + 1,
                        this.options.length - 1,
                    );
                    break;

                case 'ArrowUp':
                    e.preventDefault();
                    this.activeIndex = Math.max(this.activeIndex - 1, 0);
                    break;

                case 'Enter':
                    e.preventDefault();
                    this.$emit('select', this.options[this.activeIndex]);
                    this.isOpen = false;
                    break;

                case 'Escape':
                    this.isOpen = false;
                    break;
            }
        },

        toggleOpen() {
            this.isOpen = !this.isOpen;
        },
    },
});
</script>

<template>
    <div
        role="combobox"
        :aria-expanded="isOpen"
        aria-haspopup="listbox"
        @keydown="handleKeyDown"
        tabindex="0"
    >
        <button @click="toggleOpen" aria-label="Toggle dropdown">
            Select an option
        </button>

        <ul v-if="isOpen" role="listbox">
            <li
                v-for="(option, index) in options"
                :key="option.value"
                role="option"
                :aria-selected="index === activeIndex"
                :class="{ active: index === activeIndex }"
                @click="$emit('select', option)"
            >
                {{ option.label }}
            </li>
        </ul>
    </div>
</template>
```

### Focus Management

```vue
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    props: {
        isOpen: {
            type: Boolean,
            required: true,
        },
    },

    emits: ['close'],

    data() {
        return {
            previousFocus: null as HTMLElement | null,
        };
    },

    watch: {
        isOpen(newValue) {
            if (newValue) {
                // Save currently focused element
                this.previousFocus = document.activeElement as HTMLElement;

                // Focus modal in next tick
                this.$nextTick(() => {
                    const modal = this.$refs.modal as HTMLElement;
                    modal?.focus();
                });
            } else {
                // Restore focus when closing
                this.previousFocus?.focus();
            }
        },
    },

    methods: {
        handleKeyDown(e: KeyboardEvent) {
            if (e.key === 'Escape') {
                this.$emit('close');
            }
        },
    },
});
</script>

<template>
    <Teleport to="body">
        <div
            v-if="isOpen"
            ref="modal"
            role="dialog"
            aria-modal="true"
            tabindex="-1"
            class="modal"
            @keydown="handleKeyDown"
        >
            <slot />
        </div>
    </Teleport>
</template>
```

---

**Remember**: Vue 3 Options API patterns enable maintainable, performant user interfaces. Use computed properties for caching, provide/inject for state, and proper accessibility attributes.

**Stack**: Vue 3.5+ Options API + TypeScript + Inertia.js + TailwindCSS + PrimeVue
