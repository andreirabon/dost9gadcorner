    </div>
</template>
```

## Performance Optimization (Vue 3)

### Computed Properties (Automatic Memoization)

```vue
<script lang="ts">
import { defineComponent } from 'vue';

interface Market {
    id: number;
    name: string;
    volume: number;
}

export default defineComponent({
    props: {
        markets: {
            type: Array as PropType<Market[]>,
            required: true,
        },
    },

    data() {
        return {
            searchQuery: '',
        };
    },

    computed: {
        // ✅ Computed properties are automatically cached
        sortedMarkets(): Market[] {
            return [...this.markets].sort((a, b) => b.volume - a.volume);
        },

        filteredMarkets(): Market[] {
            return this.sortedMarkets.filter((m) =>
                m.name.toLowerCase().includes(this.searchQuery.toLowerCase()),
            );
        },

        totalVolume(): number {
            return this.markets.reduce((sum, m) => sum + m.volume, 0);
        },
    },

    methods: {
        // ✅ Methods are automatically bound to component instance
        handleSearch(query: string) {
            this.searchQuery = query;
        },
    },
});
</script>

<template>
    <div>
        <input
            :value="searchQuery"
            @input="handleSearch($event.target.value)"
            placeholder="Search..."
        />

        <p>Total Volume: {{ totalVolume }}</p>

        <MarketCard
            v-for="market in filteredMarkets"
            :key="market.id"
            :market="market"
        />
    </div>
</template>
```

