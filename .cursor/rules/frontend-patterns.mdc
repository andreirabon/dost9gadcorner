### Compound Components (Provide/Inject)

```vue
<!-- Tabs.vue -->
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    name: 'Tabs',

    props: {
        defaultTab: {
            type: String,
            required: true,
        },
    },

    data() {
        return {
            activeTab: this.defaultTab,
        };
    },

    provide() {
        return {
            activeTab: () => this.activeTab,
            setActiveTab: (tab: string) => {
                this.activeTab = tab;
            },
        };
    },
});
</script>

<template>
    <div class="tabs">
        <slot />
    </div>
</template>

<!-- TabList.vue -->
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    name: 'TabList',
});
</script>

<template>
    <div class="tab-list">
        <slot />
    </div>
</template>

<!-- Tab.vue -->
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    name: 'Tab',

    inject: ['activeTab', 'setActiveTab'],

    props: {
        id: {
            type: String,
            required: true,
        },
    },

    computed: {
        isActive(): boolean {
            return this.activeTab() === this.id;
        },
    },
});
</script>

<template>
    <button :class="{ active: isActive }" @click="setActiveTab(id)">
        <slot />
    </button>
</template>

<!-- Usage -->
<template>
    <Tabs default-tab="overview">
        <TabList>
            <Tab id="overview">Overview</Tab>
            <Tab id="details">Details</Tab>
        </TabList>
    </Tabs>
</template>
```

### Scoped Slots Pattern

```vue
<!-- DataLoader.vue -->
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    name: 'DataLoader',

    props: {
        url: {
            type: String,
            required: true,
        },
    },

    data() {
        return {
            data: null as any,
            loading: true,
            error: null as Error | null,
        };
    },

    mounted() {
        this.fetchData();
    },

    methods: {
        async fetchData() {
            this.loading = true;
            this.error = null;

            try {
                const response = await fetch(this.url);
                this.data = await response.json();
            } catch (err) {
                this.error = err as Error;
            } finally {
                this.loading = false;
            }
        },
    },
});
</script>

<template>
    <div>
        <slot
            :data="data"
            :loading="loading"
            :error="error"
            :refetch="fetchData"
        />
    </div>
</template>

<!-- Usage -->
<template>
    <DataLoader url="/markets">
        <template #default="{ data, loading, error }">
            <Spinner v-if="loading" />
            <ErrorMessage v-else-if="error" :error="error" />
            <MarketList v-else :markets="data" />
        </template>
    </DataLoader>
</template>
```

## Reusable Logic Patterns (Options API)

### Toggle Pattern

```vue
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    data() {
        return {
            isOpen: false,
        };
    },

    methods: {
        toggle() {
            this.isOpen = !this.isOpen;
        },

        open() {
            this.isOpen = true;
        },

        close() {
            this.isOpen = false;
        },
    },
});
</script>

<!-- Usage -->
<template>
    <div>
        <button @click="toggle">Toggle</button>
        <Modal v-if="isOpen" @close="close"> Content </Modal>
    </div>
</template>
```

### Async Data Fetching Pattern

```vue
<script lang="ts">
import { defineComponent } from 'vue';

interface Market {
    id: number;
    name: string;
}

export default defineComponent({
    data() {
        return {
            markets: [] as Market[],
            loading: false,
            error: null as Error | null,
        };
    },

    mounted() {
        this.fetchMarkets();
    },

    methods: {
        async fetchMarkets() {
            this.loading = true;
            this.error = null;

            try {
                const response = await fetch('/markets');
                this.markets = await response.json();

                // Success callback
                console.log('Fetched', this.markets.length, 'markets');
            } catch (err) {
                this.error = err as Error;

                // Error callback
                console.error('Failed:', err);
            } finally {
                this.loading = false;
            }
        },

        async refetch() {
            await this.fetchMarkets();
        },
    },
});
</script>

<template>
    <div>
        <Spinner v-if="loading" />
        <ErrorMessage v-else-if="error" :error="error" />
        <MarketList v-else :markets="markets" />

        <button @click="refetch">Refresh</button>
    </div>
</template>
```

### Debounce Pattern

```vue
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    data() {
        return {
            searchQuery: '',
            debouncedQuery: '',
            debounceTimeout: null as ReturnType<typeof setTimeout> | null,
        };
    },

    watch: {
        searchQuery(newValue) {
            // Clear existing timeout
            if (this.debounceTimeout) {
                clearTimeout(this.debounceTimeout);
            }

            // Set new timeout
            this.debounceTimeout = setTimeout(() => {
                this.debouncedQuery = newValue;
            }, 500);
        },

        debouncedQuery(newValue) {
            if (newValue) {
                this.performSearch(newValue);
            }
        },
    },

    beforeUnmount() {
        if (this.debounceTimeout) {
            clearTimeout(this.debounceTimeout);
        }
    },

    methods: {
        async performSearch(query: string) {
            console.log('Searching for:', query);
            // Perform search
        },
    },
});
</script>

<template>
    <input v-model="searchQuery" placeholder="Search..." type="text" />
</template>
```

## State Management Patterns (Vue 3 Options API)

### Simple Store Pattern

```typescript
// stores/marketStore.ts
import { reactive } from 'vue';

interface Market {
    id: number;
    name: string;
}

interface MarketState {
    markets: Market[];
    selectedMarket: Market | null;
    loading: boolean;
}

export const marketStore = reactive<MarketState>({
    markets: [],
    selectedMarket: null,
    loading: false,
});

export const marketActions = {
    setMarkets(markets: Market[]) {
        marketStore.markets = markets;
    },

    selectMarket(market: Market) {
        marketStore.selectedMarket = market;
    },

    setLoading(loading: boolean) {
        marketStore.loading = loading;
    },

    async fetchMarkets() {
        this.setLoading(true);
        try {
            const response = await fetch('/markets');
            const data = await response.json();
            this.setMarkets(data);
        } catch (error) {
            console.error('Failed to fetch markets:', error);
        } finally {
            this.setLoading(false);
        }
    },
};
```

```vue
<!-- Usage in component -->
<script lang="ts">
import { defineComponent } from 'vue';
import { marketStore, marketActions } from '@/stores/marketStore';

export default defineComponent({
    data() {
        return {
            store: marketStore,
        };
    },

    computed: {
        markets() {
            return this.store.markets;
        },

        selectedMarket() {
            return this.store.selectedMarket;
        },

        loading() {
            return this.store.loading;
        },
    },

    mounted() {
        marketActions.fetchMarkets();
    },

    methods: {
        selectMarket(market: any) {
            marketActions.selectMarket(market);
        },
    },
});
