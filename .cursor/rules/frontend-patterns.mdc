### Virtual Scrolling for Long Lists (Vue 3)

```vue
<script lang="ts">
import { defineComponent, PropType } from 'vue';

interface Market {
    id: number;
    name: string;
}

export default defineComponent({
    props: {
        markets: {
            type: Array as PropType<Market[]>,
            required: true,
        },
    },

    data() {
        return {
            itemHeight: 100,
            visibleCount: 10,
            scrollTop: 0,
        };
    },

    computed: {
        totalHeight(): number {
            return this.markets.length * this.itemHeight;
        },

        startIndex(): number {
            return Math.floor(this.scrollTop / this.itemHeight);
        },

        endIndex(): number {
            return Math.min(
                this.startIndex + this.visibleCount + 5, // Overscan
                this.markets.length,
            );
        },

        visibleMarkets(): Market[] {
            return this.markets.slice(this.startIndex, this.endIndex);
        },

        offsetY(): number {
            return this.startIndex * this.itemHeight;
        },
    },

    methods: {
        handleScroll(event: Event) {
            const target = event.target as HTMLElement;
            this.scrollTop = target.scrollTop;
        },
    },
});
</script>

<template>
    <div
        class="virtual-list"
        style="height: 600px; overflow: auto"
        @scroll="handleScroll"
    >
        <div :style="{ height: `${totalHeight}px`, position: 'relative' }">
            <div :style="{ transform: `translateY(${offsetY}px)` }">
                <MarketCard
                    v-for="(market, index) in visibleMarkets"
                    :key="market.id"
                    :market="market"
                    :style="{ height: `${itemHeight}px` }"
                />
            </div>
        </div>
    </div>
</template>
```

## Form Handling Patterns (Vue 3)

### Form with Validation

```vue
<script lang="ts">
import { defineComponent } from 'vue';

interface FormData {
    name: string;
    description: string;
    endDate: string;
}

interface FormErrors {
    name?: string;
    description?: string;
    endDate?: string;
}

export default defineComponent({
    data() {
        return {
            form: {
                name: '',
                description: '',
                endDate: '',
            } as FormData,

            errors: {} as FormErrors,

            submitting: false,
        };
    },

    methods: {
        validate(): boolean {
            const newErrors: FormErrors = {};

            if (!this.form.name.trim()) {
                newErrors.name = 'Name is required';
            } else if (this.form.name.length > 200) {
                newErrors.name = 'Name must be under 200 characters';
            }

            if (!this.form.description.trim()) {
                newErrors.description = 'Description is required';
            }

            if (!this.form.endDate) {
                newErrors.endDate = 'End date is required';
            }

            this.errors = newErrors;
            return Object.keys(newErrors).length === 0;
        },

        async handleSubmit() {
            if (!this.validate()) return;

            this.submitting = true;

            try {
                await this.createMarket(this.form);
                // Success handling
                this.$emit('success');
            } catch (error) {
                // Error handling
                console.error('Failed to create market:', error);
            } finally {
                this.submitting = false;
            }
        },

        async createMarket(data: FormData) {
            const response = await fetch('/markets', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (!response.ok) {
                throw new Error('Failed to create market');
            }

            return response.json();
        },
    },
});
</script>

<template>
    <form @submit.prevent="handleSubmit">
        <div class="form-group">
            <input
                v-model="form.name"
                type="text"
                placeholder="Market name"
                :class="{ error: errors.name }"
            />
            <span v-if="errors.name" class="error-message">
                {{ errors.name }}
            </span>
        </div>

        <div class="form-group">
            <textarea
                v-model="form.description"
                placeholder="Description"
                :class="{ error: errors.description }"
            />
            <span v-if="errors.description" class="error-message">
                {{ errors.description }}
            </span>
        </div>

        <div class="form-group">
            <input
                v-model="form.endDate"
                type="date"
                :class="{ error: errors.endDate }"
            />
            <span v-if="errors.endDate" class="error-message">
                {{ errors.endDate }}
            </span>
        </div>

        <button type="submit" :disabled="submitting">
            {{ submitting ? 'Creating...' : 'Create Market' }}
        </button>
    </form>
</template>
```

## Error Handling Pattern (Vue 3)

### Error Boundary Component

```vue
<!-- ErrorBoundary.vue -->
<script lang="ts">
import { defineComponent } from 'vue';

export default defineComponent({
    name: 'ErrorBoundary',

    data() {
        return {
            hasError: false,
            error: null as Error | null,
        };
    },

    errorCaptured(err: Error, instance, info: string) {
        console.error('Error boundary caught:', err, info);

        this.hasError = true;
        this.error = err;

        // Prevent error from propagating
        return false;
    },

    methods: {
        retry() {
            this.hasError = false;
            this.error = null;
        },
    },
});
</script>

<template>
    <div v-if="hasError" class="error-fallback">
        <h2>Something went wrong</h2>
        <p>{{ error?.message }}</p>
        <button @click="retry">Try again</button>
    </div>

    <slot v-else />
</template>

<!-- Usage -->
<template>
    <ErrorBoundary>
        <App />
    </ErrorBoundary>
</template>
```

## Animation Patterns (Vue 3)

### Transition & TransitionGroup

```vue
<!-- List Animations -->
<script lang="ts">
import { defineComponent, PropType } from 'vue';

interface Market {
    id: number;
    name: string;
}

export default defineComponent({
    props: {
        markets: {
            type: Array as PropType<Market[]>,
            required: true,
        },
