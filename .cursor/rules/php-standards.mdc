## PHP 8.2+ Modern Features

### Constructor Property Promotion

```php
<?php

// ❌ OLD WAY: Verbose property declaration
class UserService
{
    private UserRepository $repository;
    private LoggerInterface $logger;

    public function __construct(
        UserRepository $repository,
        LoggerInterface $logger
    ) {
        $this->repository = $repository;
        $this->logger = $logger;
    }
}

// ✅ NEW WAY: Constructor property promotion (PHP 8.0+)
class UserService
{
    public function __construct(
        private UserRepository $repository,
        private LoggerInterface $logger,
    ) {}
}
```

### Named Arguments

```php
<?php

// ✅ GOOD: Named arguments for clarity
$market = Market::create(
    name: 'Presidential Election 2024',
    description: 'Will Trump win?',
    category: 'politics',
    endDate: '2024-11-05',
);

// ✅ Mix positional and named arguments
$result = $this->searchMarkets(
    'election',
    limit: 10,
    sortBy: 'volume'
);
```

### Match Expression (PHP 8.0+)

```php
<?php

// ❌ OLD: Switch statement
function getStatusColor(string $status): string
{
    switch ($status) {
        case 'active':
            return 'green';
        case 'resolved':
            return 'blue';
        case 'closed':
            return 'gray';
        default:
            return 'red';
    }
}

// ✅ NEW: Match expression
function getStatusColor(string $status): string
{
    return match ($status) {
        'active' => 'green',
        'resolved' => 'blue',
        'closed' => 'gray',
        default => 'red',
    };
}
```

### Null Safe Operator (PHP 8.0+)

```php
<?php

// ❌ OLD: Multiple null checks
$country = null;
if ($user !== null) {
    if ($user->getAddress() !== null) {
        $country = $user->getAddress()->getCountry();
    }
}

// ✅ NEW: Null safe operator
$country = $user?->getAddress()?->getCountry();
```

### Union Types (PHP 8.0+)

```php
<?php

class MarketService
{
    // ✅ Union types
    public function findMarket(int|string $identifier): ?Market
    {
        if (is_int($identifier)) {
            return Market::find($identifier);
        }

        return Market::where('slug', $identifier)->first();
    }

    // ✅ Multiple union types
    public function processValue(int|float|string $value): int|float
    {
        return is_string($value) ? (float) $value : $value;
    }
}
```

### Enums (PHP 8.1+)

```php
<?php

namespace App\Enums;

enum MarketStatus: string
{
    case ACTIVE = 'active';
    case RESOLVED = 'resolved';
    case CLOSED = 'closed';
    case CANCELLED = 'cancelled';

    // ✅ Enum methods
    public function label(): string
    {
        return match ($this) {
            self::ACTIVE => 'Active',
            self::RESOLVED => 'Resolved',
            self::CLOSED => 'Closed',
            self::CANCELLED => 'Cancelled',
        };
    }

    public function color(): string
    {
        return match ($this) {
            self::ACTIVE => 'green',
            self::RESOLVED => 'blue',
            self::CLOSED => 'gray',
            self::CANCELLED => 'red',
        };
    }

    public function isActive(): bool
    {
        return $this === self::ACTIVE;
    }
}

// Usage in Model
class Market extends Model
{
    protected function casts(): array
    {
        return [
            'status' => MarketStatus::class,
        ];
    }
}

// Usage in code
$market->status = MarketStatus::ACTIVE;
if ($market->status->isActive()) {
    // Do something
}
```

