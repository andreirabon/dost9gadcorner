## Laravel Naming Conventions

### Controllers

```php
<?php

// ✅ GOOD: Singular noun + Controller
class MarketController extends Controller {}
class UserController extends Controller {}
class PositionController extends Controller {}

// ❌ BAD: Plural or inconsistent naming
class MarketsController extends Controller {}
class MarketControllers extends Controller {}
```

### Models

```php
<?php

// ✅ GOOD: Singular, PascalCase
class Market extends Model {}
class User extends Model {}
class MarketOption extends Model {}

// ❌ BAD: Plural
class Markets extends Model {}
```

### Database Tables

```php
<?php

// ✅ GOOD: Plural, snake_case
// markets, users, market_options, user_positions

// Model automatically maps to plural table name
class Market extends Model
{
    // No need to specify $table if following convention
}

// Override if needed
class Person extends Model
{
    protected $table = 'people';
}
```

### Relationships

```php
<?php

class Market extends Model
{
    // ✅ HasMany: plural method name
    public function positions(): HasMany
    {
        return $this->hasMany(Position::class);
    }

    // ✅ BelongsTo: singular method name
    public function creator(): BelongsTo
    {
        return $this->belongsTo(User::class, 'creator_id');
    }

    // ✅ BelongsToMany: plural method name
    public function participants(): BelongsToMany
    {
        return $this->belongsToMany(User::class, 'market_user');
    }
}
```

### Methods

```php
<?php

class MarketService
{
    // ✅ GOOD: Verb-noun pattern, camelCase
    public function createMarket(array $data): Market {}
    public function calculateProbabilities(Market $market): array {}
    public function isMarketActive(Market $market): bool {}
    public function getUserMarkets(User $user): Collection {}

    // ❌ BAD: Unclear or noun-only
    public function market(array $data): Market {}
    public function probabilities(Market $market): array {}
}
```

## Error Handling

### Try-Catch Blocks

```php
<?php

class MarketService
{
    public function createMarket(array $data): Market
    {
        try {
            DB::beginTransaction();

            $market = Market::create($data);

            foreach ($data['options'] as $option) {
                $market->options()->create($option);
            }

            DB::commit();

            return $market;

        } catch (ValidationException $e) {
            DB::rollBack();
            Log::warning('Market validation failed', [
                'data' => $data,
                'errors' => $e->errors(),
            ]);
            throw $e;

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Failed to create market', [
                'data' => $data,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);
            throw new MarketCreationException(
                'Failed to create market: ' . $e->getMessage(),
                previous: $e
            );
        }
    }
}
```

### Custom Exceptions

```php
<?php

namespace App\Exceptions;

use Exception;

class MarketCreationException extends Exception
{
    public function __construct(
        string $message = 'Failed to create market',
        int $code = 0,
        ?\Throwable $previous = null,
    ) {
        parent::__construct($message, $code, $previous);
    }

    public function report(): void
    {
        // Custom error reporting
        Log::channel('markets')->error($this->getMessage(), [
            'exception' => get_class($this),
            'file' => $this->getFile(),
            'line' => $this->getLine(),
        ]);
    }

    public function render($request): Response
    {
        return response()->json([
            'success' => false,
            'error' => $this->getMessage(),
        ], 500);
    }
}
```

