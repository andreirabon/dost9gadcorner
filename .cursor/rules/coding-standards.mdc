};
</script>
```

### Conditional Rendering

```vue
<template>
    <!-- ✅ GOOD: Clear conditional rendering -->
    <Spinner v-if="isLoading" />
    <ErrorMessage v-else-if="error" :error="error" />
    <DataDisplay v-else-if="data" :data="data" />

    <!-- ❌ BAD: Nested ternaries (use v-if/v-else-if instead) -->
