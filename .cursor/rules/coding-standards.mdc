## Laravel Routing & API Standards

### Laravel Route Conventions

```php
// ✅ GOOD: RESTful resource routes with Inertia
Route::middleware(['auth'])->group(function () {
    // Resource routes (Inertia pages)
    Route::resource('markets', MarketController::class);

    // Generated routes:
    // GET    /markets              # index()   - List all markets
    // GET    /markets/create       # create()  - Show create form
    // POST   /markets              # store()   - Create new market
    // GET    /markets/{market}     # show()    - Show specific market
    // GET    /markets/{market}/edit # edit()   - Show edit form
    // PUT    /markets/{market}     # update()  - Update market
    // DELETE /markets/{market}     # destroy() - Delete market
});

// API routes (if needed for external consumption)
Route::prefix('api')->middleware(['auth:sanctum'])->group(function () {
    Route::get('/markets', [Api\MarketController::class, 'index']);
    Route::post('/markets', [Api\MarketController::class, 'store']);
});
```

### Laravel Inertia Response Format

```php
// ✅ GOOD: Inertia response with proper structure
public function index(Request $request): Response
{
    $markets = Market::query()
        ->when($request->input('status'), fn($q, $status) =>
            $q->where('status', $status)
        )
        ->with(['creator:id,name', 'options'])
        ->paginate(10)
        ->withQueryString();

    return Inertia::render('Markets/Index', [
        'markets' => $markets,
        'filters' => $request->only(['status', 'category']),
    ]);
}

// ✅ GOOD: JSON response for API endpoints
public function store(StoreMarketRequest $request): JsonResponse
{
    $market = $this->marketService->create($request->validated());

    return response()->json([
        'success' => true,
        'data' => new MarketResource($market),
        'message' => 'Market created successfully'
    ], 201);
}

// Error response
return response()->json([
    'success' => false,
    'message' => 'Invalid request',
    'errors' => $validator->errors()
], 422);
```

