{
    $validated = $request->validate([
        // Long validation rules here - BAD!
    ]);
}
```

### Error Handling (PHP/Laravel)

```php
// ✅ GOOD: Proper exception handling
public function fetchExternalData(string $url): array
{
    try {
        $response = Http::timeout(5)->get($url);

        if ($response->failed()) {
            throw new ExternalApiException('API request failed');
        }

        return $response->json();
    } catch (\Exception $e) {
        Log::error('External API error', [
            'url' => $url,
            'error' => $e->getMessage()
        ]);

        throw $e;
    }
}

// ❌ BAD: No error handling
public function fetchExternalData($url)
{
    $response = Http::get($url);
    return $response->json();
}
```

