## Vue 3 Best Practices

### Component Structure (Options API)

```vue
<script lang="ts">
import { defineComponent, PropType } from 'vue';

interface ButtonVariant {
    variant: 'primary' | 'secondary';
}

export default defineComponent({
    name: 'Button',

    props: {
        disabled: {
            type: Boolean,
            default: false,
        },
        variant: {
            type: String as PropType<ButtonVariant['variant']>,
            default: 'primary',
        },
    },

    emits: ['click'],

    methods: {
        handleClick() {
            if (!this.disabled) {
                this.$emit('click');
            }
        },
    },
});
</script>

<template>
    <button
        :disabled="disabled"
        :class="`btn btn-${variant}`"
        @click="handleClick"
    >
        <slot />
    </button>
</template>
```

### Computed Properties & Watchers

```vue
<script>
import { defineComponent } from 'vue';

export default defineComponent({
    data() {
        return {
            searchQuery: '',
            debouncedQuery: '',
        };
    },

    watch: {
        searchQuery: {
            handler(newValue) {
                clearTimeout(this.debounceTimeout);
                this.debounceTimeout = setTimeout(() => {
                    this.debouncedQuery = newValue;
                }, 500);
            },
            immediate: true,
        },
    },

    beforeUnmount() {
        clearTimeout(this.debounceTimeout);
    },
});
</script>
```

### State Management

```vue
<script>
export default {
    data() {
        return {
            count: 0,
        };
    },

    methods: {
        // ✅ GOOD: Update state directly in Options API
        increment() {
            this.count++;
        },

        // ✅ GOOD: Functional update when based on current value
